# 프로젝트 .env.local로 복사하고 자리표시자를 바꾸세요. 비밀값은 Git에 넣지 마세요.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
GP_DEMO_BASE_URL=http://localhost:3000/api/lp/v1
GP_DEMO_API_KEY=replace-with-same-gp-api-key
GP_DEMO_WEBHOOK_SECRET=replace-with-same-gp-webhook-secret
CRON_SECRET=replace-with-random-local-cron-secret
# 배포 데모 전용 DB를 사용할 때만 지정합니다.
# APP_DATABASE_URL=
